# ==============================================================================
# VALOBOT Configuration (.env)
# ==============================================================================

# Port for the Node.js Express & WebSocket server (and Docker mapping)
PORT=6788

# Timezone (defaults to Europe/Paris, e.g. Europe/Paris, UTC, America/New_York)
TIMEZONE=Europe/Paris

# Public URL (served behind Apache reverse proxy)
WEB_BASE_URL=https://valobot.example.com

# Discord Application & Bot Credentials
# Get these from the Discord Developer Portal: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Discord OAuth2 Client Secret (from Discord Developer Portal > OAuth2 > Client Secret)
# Required to authenticate web users and restrict access to channels they have permissions in
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Secret used to sign login cookies. REQUIRED in production, at least 32 random chars.
# Generate one with: openssl rand -hex 32   (never reuse the bot token or client secret)
SESSION_SECRET=

# (Optional) Rank & match stats before/after games, through the HenrikDev API (free key).
# Get one on https://docs.henrikdev.xyz (Discord login, dashboard) . Leave empty to disable stats.
HENRIK_API_KEY=
# Default Valorant region for linked accounts: eu, na, ap, kr, latam, br
VALORANT_REGION=eu

# (Optional) Memes for the reminder / flop messages. Drop image files in assets/memes/flop and assets/memes/reminder
# (best option), or give DIRECT image links (ending in .gif/.png/.jpg/.webp), comma separated.
# Page links such as klipy.com/gifs/xxx cannot be shown inside an embed.
FLOP_MEME_URLS=
REMINDER_MEME_URLS=

# (Optional) Test Guild ID for instant Slash Command updates during development
DISCORD_GUILD_ID=

# (Optional) Restrict bot and commands to specific channel ID(s) (comma-separated)
# Example: ALLOWED_CHANNEL_IDS=123456789012345678
ALLOWED_CHANNEL_IDS=

# The bot asks for the privileged "Server Members Intent" so the "didn't respond" list covers every channel member.
# Enable it in the Developer Portal (Bot > Privileged Gateway Intents). If it is off, the bot falls back automatically
# (incomplete list). Set to true to never request it.
DISABLE_MEMBERS_INTENT=false
